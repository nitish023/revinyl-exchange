# Copy to .env and fill in. Never commit .env.

# Local Postgres from `npm run db:up`. On Render this is your Neon connection string.
DATABASE_URL=postgres://revinyl:revinyl@localhost:5433/revinyl

# Discogs personal access token (discogs.com > Settings > Developers). Needed for search.
# Pressing pages work without it, more slowly.
DISCOGS_TOKEN=

# Discogs asks every app to identify itself.
DISCOGS_USER_AGENT=reVINYL/0.1 (+https://github.com/nitish023/revinyl-exchange)

# Optional
# PORT=3000
# CATALOG_MAX_AGE_HOURS=6
# DISCOGS_REQUESTS_PER_MINUTE=30
